api.139-59-147-172.sslip.io {
    encode zstd gzip

    # Matchers
    @from_app header Origin https://applitrack-app-hv8px.ondigitalocean.app
    @preflight {
        method OPTIONS
        header Origin https://applitrack-app-hv8px.ondigitalocean.app
    }

    # Preflight: add CORS headers then 204
    handle @preflight {
        header {
            Access-Control-Allow-Origin {http.request.header.Origin}
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers {http.request.header.Access-Control-Request-Headers}
            Access-Control-Allow-Credentials true
            Vary "Origin, Access-Control-Request-Headers"
        }
        respond 204
    }

    # Actual requests from allowed origin: add CORS headers then proxy
    handle @from_app {
        header {
            Access-Control-Allow-Origin {http.request.header.Origin}
            Access-Control-Allow-Credentials true
            Vary "Origin"
        }
        reverse_proxy api:8080
    }

    # Fallback: proxy everything else
    handle {
        reverse_proxy api:8080
    }
}
