api.139-59-147-172.sslip.io {
    encode zstd gzip

    # CORS at proxy: allow only your frontend origin with credentials
    # Remove any upstream CORS headers to avoid duplicates/conflicts
    @from_app header Origin https://applitrack-app-hv8px.ondigitalocean.app
    header @from_app -Access-Control-Allow-Origin
    header @from_app -Access-Control-Allow-Credentials
    header @from_app -Access-Control-Allow-Headers
    header @from_app -Access-Control-Allow-Methods
    route @from_app {
        header {
            Access-Control-Allow-Origin {http.request.header.Origin}
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers {http.request.header.Access-Control-Request-Headers}
            Access-Control-Allow-Credentials true
            Vary "Origin, Access-Control-Request-Headers"
        }
        reverse_proxy api:8080
    }

    # Handle preflight requests from the allowed origin
    @preflight {
        method OPTIONS
        header Origin https://applitrack-app-hv8px.ondigitalocean.app
    }
    route @preflight {
        header {
            Access-Control-Allow-Origin {http.request.header.Origin}
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers {http.request.header.Access-Control-Request-Headers}
            Access-Control-Allow-Credentials true
            Vary "Origin, Access-Control-Request-Headers"
        }
        respond 204
    }

    # Fallback: reverse proxy to the API service on the Docker network
    @not_options {
        not {
            method OPTIONS
        }
    }
    reverse_proxy @not_options api:8080
}
