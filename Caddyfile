api.139-59-147-172.sslip.io {
    encode zstd gzip

    # CORS: allow only your frontend origin and credentials
    @from_app header Origin https://applitrack-app-hv8px.ondigitalocean.app
    header @from_app {
        Access-Control-Allow-Origin {http.request.header.Origin}
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
        Access-Control-Allow-Credentials true
        Vary "Origin"
    }

    # Handle preflight requests
    @preflight method OPTIONS
    respond @preflight 204

    # Reverse proxy to the API service on the Docker network
    reverse_proxy api:8080
}

