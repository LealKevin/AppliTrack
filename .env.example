# JWT Configuration
JWTSECRET=your-super-secure-32-character-secret-key-here

# Database Configuration
DATABASE_URL=postgres://username:password@localhost:5432/dbname
# Optional: Explicitly set SSL mode (defaults: disable for development, require for production)
SSL_MODE=require

# CORS Configuration (comma-separated)
# Example for DigitalOcean static hosting:
# CORS_ALLOWED_ORIGINS=https://applitrack-app-hv8px.ondigitalocean.app
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Environment
GO_ENV=production
